# 生产 Compose 的变量模板。复制到仓库外受控路径、填值后通过 --env-file 引用；禁止提交真实值。
# 示例：docker compose --env-file /secure/devmind.env -f deploy/docker-compose.prod.yml config --quiet
DEVMIND_BACKEND_IMAGE=
DEVMIND_FRONTEND_IMAGE=
DEVMIND_HOSTNAME=devmind.example.com
DEVMIND_WEBHOOK_HOSTNAME=devmind-webhooks.example.com
DEVMIND_API_KEYS=
DEVMIND_ADMIN_API_KEYS=
DEVMIND_FRONTEND_API_KEY=
GITHUB_WEBHOOK_SECRET=
ALERT_WEBHOOK_SECRET=

# 必须使用 TLS：PostgreSQL sslmode=require/verify-ca/verify-full、rediss、neo4j+s/bolt+s。
DATABASE_URL=
# 独立迁移角色，可执行 DDL/CREATE EXTENSION；不得注入 API 或 worker。
MIGRATION_DATABASE_URL=
REDIS_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
CODE_INDEX_HOST_PATH=

# 仅填写 LLM_DEFAULT_MODEL / EMBEDDING_MODEL 实际使用的供应商凭据。
# 应用会根据模型前缀校验；缺少对应 Key 时生产启动会失败。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
OPENAI_API_KEY=
# 只有经安全审核、使用企业工作负载身份的自定义供应商才能改为 true。
ALLOW_UNVALIDATED_MODEL_PROVIDER=false
GITHUB_TOKEN=
IM_WEBHOOK_URL=
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_DEFAULT_PROJECT=

# 默认只监听本机，由外部 TLS/OIDC 反向代理转发。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# 只列可信代理 IP/CIDR；禁止使用 *。
FORWARDED_ALLOW_IPS=127.0.0.1
