# ===== 应用配置 =====
APP_NAME=DevMind
APP_ENV=local
LOG_LEVEL=INFO
# 前端地址，用于 CORS
CORS_ORIGINS=http://localhost:5173

# ===== LLM 网关 (LiteLLM 接入国内模型) =====
# 主力模型，LiteLLM 命名规则见: https://docs.litellm.ai/docs/providers
# DeepSeek: deepseek/deepseek-chat ; 通义: dashscope/qwen-max ; 智谱: zhipuai/glm-4
LLM_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.3

# 各厂商 API Key (按需填写，LiteLLM 会自动读取对应环境变量)
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=

# ===== 数据库 / 缓存 (P0 预留，最小闭环可暂不使用) =====
DATABASE_URL=postgresql+psycopg://devmind:devmind@localhost:5432/devmind
REDIS_URL=redis://localhost:6379/0

# ===== 可观测 (Langfuse，可选；不填则自动跳过) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
