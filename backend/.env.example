# DevMind 本地开发配置模板：复制为 backend/.env 后按所启用能力填写。
# 使用：cp .env.example .env；生产不要复用这些默认凭据，应使用 Secret/工作负载身份。

# ===== 应用配置 =====
APP_NAME=DevMind
APP_ENV=local
LOG_LEVEL=INFO
# 前端地址，用于 CORS
CORS_ORIGINS=http://localhost:5173

# ===== API / Webhook 安全（以下是本地开发值）=====
# 非本地环境强制启用鉴权、禁用 unsigned/dry-run，并要求 TLS 上游。
AUTH_ENABLED=false
DEVMIND_API_KEYS=
DEVMIND_ADMIN_API_KEYS=
TRUSTED_HOSTS=localhost,127.0.0.1
EXPOSE_API_DOCS=true
REQUIRE_TLS_UPSTREAMS=false
ALLOW_UNSIGNED_WEBHOOKS=true
ALERT_WEBHOOK_SECRET=
# 请求/外部响应资源边界（单位：字节）；通常保持默认，调整前先做容量与代理配置评审。
MAX_REQUEST_BODY_BYTES=2097152
MAX_WEBHOOK_BODY_BYTES=1048576
UPSTREAM_MAX_RESPONSE_BYTES=2097152

# ===== LLM 网关 (LiteLLM 接入国内模型) =====
# 主力模型，LiteLLM 命名规则见: https://docs.litellm.ai/docs/providers
# DeepSeek: deepseek/deepseek-chat ; 通义: dashscope/qwen-max ; 智谱: zhipuai/glm-4
LLM_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.3
# 单次模型调用与整条 Agent/SSE 的执行预算。
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
AGENT_RECURSION_LIMIT=12
SSE_MAX_DURATION_SECONDS=600

# 各厂商 API Key（按实际模型填写；应用会显式传给对应 provider）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
OPENAI_API_KEY=

# ===== Embedding (P1 RAG 向量化) =====
# 注意：embedding 模型与维度必须匹配，换模型需重建向量表。
# 通义 text-embedding-v3 → dim 1024 (默认) ; 智谱 embedding-3 → dim 2048
# OpenAI text-embedding-3-small → dim 1536
EMBEDDING_MODEL=dashscope/text-embedding-v3
EMBEDDING_DIM=1024
# 文本按字符近似分块；生产调参应由检索评测驱动。
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4

# ===== 数据库 / 缓存 =====
# P1 RAG 必需 PostgreSQL + pgvector（用 deploy/docker-compose.yml 起）
DATABASE_URL=postgresql+psycopg://devmind:devmind@localhost:5432/devmind
# 生产建议配置独立 DDL 角色；本地留空时 Alembic 使用 DATABASE_URL。
MIGRATION_DATABASE_URL=
# Redis 用于 P2/P3 的 ARQ 异步任务队列及跨副本成本聚合
REDIS_URL=redis://localhost:6379/0
# 连接池是“每进程”配置；多 Pod/worker 的总连接数需低于数据库容量。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ===== 代码审查 Agent (P2) =====
# GitHub Personal Access Token（拉 PR diff、回写 review 评论需要 repo 权限）
GITHUB_TOKEN=
# Webhook 校验密钥（在 GitHub 仓库 Webhook 设置里填同样的值）
GITHUB_WEBHOOK_SECRET=

# ===== 告警根因 Agent (P3, AIOps) =====
# 以下留空时各自使用 mock 数据，便于无监控环境也能跑通完整链路
PROMETHEUS_URL=
LOKI_URL=
DEPLOY_REPO=          # 形如 liuwentong01/devmind，用于关联近期发布 commit
IM_WEBHOOK_URL=       # 飞书/Slack 群机器人 webhook，留空则只记日志
RCA_MAX_ITERATIONS=2
RCA_CONFIDENCE_THRESHOLD=0.75
RCA_MAX_EVIDENCE_CHARS=12000

# ===== 代码理解 Agent (P5) =====
# Neo4j 代码图谱（用 deploy/docker-compose.yml 起）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devmind-neo4j
CODE_INDEX_MAX_FILES=800
CODE_INDEX_MAX_FILE_BYTES=1048576
CODE_INDEX_MAX_TOTAL_BYTES=67108864
CODE_INDEX_MAX_FUNCTIONS=50000
CODE_INDEX_MAX_CALLS=200000
# 生产必须设置为逗号分隔的绝对路径，并只挂载批准的只读代码目录。
CODE_INDEX_ALLOWED_ROOTS=

# ===== 需求拆解 Agent (P4, Atlassian) =====
# 留空时 Jira 写入走 dry-run（返回 DRY-x 假 key），便于无 Atlassian 环境演示 HITL
ATLASSIAN_BASE_URL=     # 如 https://your.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_DEFAULT_PROJECT=   # Jira 项目 key，如 DEV
ALLOW_JIRA_DRY_RUN=true # 仅 local/test 允许；非本地强制 false
CONFLUENCE_MAX_RESPONSE_BYTES=2097152
CONFLUENCE_MAX_TEXT_CHARS=100000

# ===== 成本统计 =====
# local 默认 memory；生产必须使用 redis 或显式 disabled，不能使用 memory。
COST_TRACKING_BACKEND=memory
COST_REDIS_KEY=devmind:cost:v1

# ===== 可观测 (Langfuse，可选；不填则自动跳过) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
